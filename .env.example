# Environment Variables Example for Creatively Lensed Portfolio

# Public Site Domain
VITE_SITE_URL=https://creativelylensed.com
VITE_STORE_URL=/store

# Gmail SMTP Configuration (To send live confirmation emails from dange.akshat2107@gmail.com)
# 1. Enable 2-Step Verification in Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App password (16 characters) and paste here:
GMAIL_USER=dange.akshat2107@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
RECIPIENT_EMAIL=dange.akshat2107@gmail.com

# Optional: Resend API Key (Alternative email provider)
RESEND_API_KEY=re_your_api_key_here

# Contact Form & Analytics
VITE_CONTACT_ENDPOINT=/api/contact
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
