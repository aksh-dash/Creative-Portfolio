# Environment Variables Example for Creatively Lensed Portfolio

# Public Site Domain
VITE_SITE_URL=https://creativelylensed.com
VITE_STORE_URL=/store

# Gmail SMTP Configuration (To send live confirmation emails from creativelensesstore@gmail.com)
# 1. Enable 2-Step Verification in Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App password (16 characters) and paste here:
GMAIL_USER=creativelensesstore@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
RECIPIENT_EMAIL=creativelensesstore@gmail.com

# Optional: Resend API Key (Alternative email provider)
RESEND_API_KEY=re_your_api_key_here

# Security: Secret key required to access waitlist export endpoint via x-admin-key header
ADMIN_SECRET_KEY=your_chosen_admin_export_secret

# Optional: Google Sheets Webhook URL for external waitlist sync
GOOGLE_SHEET_URL=https://script.google.com/macros/s/your_script_id/exec

# Maintenance Mode (set to true to replace entire site with branded maintenance page)
# In Vercel: Project Settings > Environment Variables > VITE_MAINTENANCE = true (or false)
VITE_MAINTENANCE=false
